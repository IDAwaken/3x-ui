--- a/handler/socks/v5/target_stats.go
+++ b/handler/socks/v5/target_stats.go
@@ -0,0 +1,176 @@
+package v5
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/go-gost/core/observer/stats"
+	xstats "github.com/go-gost/x/observer/stats"
+	xrecorder "github.com/go-gost/x/recorder"
+)
+
+type targetMeter struct {
+	counters xstats.Stats
+	session  *xrecorder.Session
+	base     xrecorder.HandlerRecorderObject
+}
+
+func (h *socks5Handler) targetMeter(ctx context.Context, base xrecorder.HandlerRecorderObject, network, host string) *targetMeter {
+	base.Network, base.Host, base.Time, base.RecordMode = network, host, time.Now(), ""
+	base.HTTP, base.TLS, base.DNS, base.Websocket, base.Redis = nil, nil, nil, nil, nil
+	base.InputBytes, base.OutputBytes = 0, 0
+	base.Labels = map[string]string{"meter": "target-v1"}
+	m := &targetMeter{base: base}
+	m.session = h.sessionRecorder.NewSession(ctx, &m.counters)
+	m.session.Start(base)
+	return m
+}
+
+func (m *targetMeter) finish(ctx context.Context) {
+	base := m.base
+	base.InputBytes = m.counters.Get(stats.KindInputBytes)
+	base.OutputBytes = m.counters.Get(stats.KindOutputBytes)
+	_ = m.session.Finish(ctx, base)
+}
+
+type payloadConn struct {
+	net.Conn
+	meter *targetMeter
+}
+
+func (c *payloadConn) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	c.meter.counters.Add(stats.KindOutputBytes, int64(n))
+	return n, e
+}
+func (c *payloadConn) Write(p []byte) (int, error) {
+	n, e := c.Conn.Write(p)
+	c.meter.counters.Add(stats.KindInputBytes, int64(n))
+	return n, e
+}
+func (c *payloadConn) CloseWrite() error {
+	if v, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return v.CloseWrite()
+	}
+	return nil
+}
+func (c *payloadConn) CloseRead() error {
+	if v, ok := c.Conn.(interface{ CloseRead() error }); ok {
+		return v.CloseRead()
+	}
+	return nil
+}
+
+type targetPacketConn struct {
+	net.PacketConn
+	handler  *socks5Handler
+	ctx      context.Context
+	base     xrecorder.HandlerRecorderObject
+	mu       sync.Mutex
+	active   sync.WaitGroup
+	closing  bool
+	once     sync.Once
+	meters   map[string]*targetMeter
+	reverse  map[string]map[string]bool
+	resolved map[string]net.Addr
+}
+
+func (c *targetPacketConn) enter() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closing {
+		return false
+	}
+	c.active.Add(1)
+	return true
+}
+func (c *targetPacketConn) meter(host string) *targetMeter {
+	m := c.meters[host]
+	if m == nil {
+		m = c.handler.targetMeter(c.ctx, c.base, "udp", host)
+		c.meters[host] = m
+	}
+	return m
+}
+func (c *targetPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	if !c.enter() {
+		return 0, net.ErrClosed
+	}
+	defer c.active.Done()
+	original := addr.String()
+	resolved := addr
+	destination := c.PacketConn
+	if r, ok := c.PacketConn.(*resolvePacketConn); ok {
+		c.mu.Lock()
+		cached := c.resolved[original]
+		c.mu.Unlock()
+		if cached != nil {
+			resolved = cached
+		} else {
+			var err error
+			resolved, err = r.resolveAddress(addr)
+			if err != nil {
+				return 0, err
+			}
+			c.mu.Lock()
+			if c.resolved == nil {
+				c.resolved = map[string]net.Addr{}
+			}
+			c.resolved[original] = resolved
+			c.mu.Unlock()
+		}
+		destination = r.PacketConn
+	}
+	// 发送前建立回包映射；同一地址对应多个域名时，下载按地址保留，避免猜测归属。
+	c.mu.Lock()
+	names := c.reverse[resolved.String()]
+	if names == nil {
+		names = map[string]bool{}
+		c.reverse[resolved.String()] = names
+	}
+	names[original] = true
+	m := c.meter(original)
+	c.mu.Unlock()
+	n, e := destination.WriteTo(p, resolved)
+	m.counters.Add(stats.KindInputBytes, int64(n))
+	return n, e
+}
+func (c *targetPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	if !c.enter() {
+		return 0, nil, net.ErrClosed
+	}
+	defer c.active.Done()
+	n, addr, e := c.PacketConn.ReadFrom(p)
+	if n > 0 && addr != nil {
+		c.mu.Lock()
+		host := addr.String()
+		names := c.reverse[host]
+		if len(names) == 1 {
+			for name := range names {
+				host = name
+			}
+		}
+		m := c.meter(host)
+		c.mu.Unlock()
+		m.counters.Add(stats.KindOutputBytes, int64(n))
+	}
+	return n, addr, e
+}
+func (c *targetPacketConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		c.mu.Lock()
+		c.closing = true
+		c.mu.Unlock()
+		err = c.PacketConn.Close()
+		c.active.Wait()
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		for _, m := range c.meters {
+			m.finish(c.ctx)
+		}
+	})
+	return err
+}
